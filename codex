const int Num_Sensor = 6;
const int Sensor_Pins[Num_Sensor] = {A5, A4, A3, A2, A1, A0};
int Sensor_Value[Num_Sensor];

const int ENA = 5;
const int IN1 = 7;
const int IN2 = 8;
const int IN3 = 9;
const int IN4 = 10;
const int ENB = 6;

const int SENSOR_THRESHOLD = 200;

// Sensor positions: left is negative, right is positive
const float Position[Num_Sensor] = {
  -2.5, -1.5, -0.5, 0.5, 1.5, 2.5
};

const int TURN_SPEED = 130;
const unsigned long TURN_MIN_TIME_MS = 150;
const unsigned long TURN_TIMEOUT_MS = 1200;
const unsigned long TURN_SETTLE_MS = 80;
const int REACQUIRE_READINGS = 3;

bool turnPatternLocked = false;

void setup() {
  for (int i = 0; i < Num_Sensor; i++) {
    pinMode(Sensor_Pins[i], INPUT);
  }

  pinMode(ENA, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  pinMode(ENB, OUTPUT);

  Serial.begin(115200);
  setMotors(0, 0);
}

void readSensors() {
  for (int i = 0; i < Num_Sensor; i++) {
    Sensor_Value[i] = analogRead(Sensor_Pins[i]);
  }
}

// Signed speed: positive uses the same direction as the original sketch.
// Negative reverses that motor.
void setMotorsSigned(int leftSpeed, int rightSpeed) {
  leftSpeed = constrain(leftSpeed, -255, 255);
  rightSpeed = constrain(rightSpeed, -255, 255);

  digitalWrite(IN1, leftSpeed >= 0 ? HIGH : LOW);
  digitalWrite(IN2, leftSpeed >= 0 ? LOW : HIGH);

  digitalWrite(IN3, rightSpeed >= 0 ? HIGH : LOW);
  digitalWrite(IN4, rightSpeed >= 0 ? LOW : HIGH);

  analogWrite(ENA, abs(leftSpeed));
  analogWrite(ENB, abs(rightSpeed));
}

// Forward-only motor command for the original line-following behavior.
void setMotors(int leftSpeed, int rightSpeed) {
  setMotorsSigned(
    constrain(leftSpeed, 0, 255),
    constrain(rightSpeed, 0, 255)
  );
}

float calculateError() {
  float sum = 0;
  int count = 0;

  for (int i = 0; i < Num_Sensor; i++) {
    if (Sensor_Value[i] < SENSOR_THRESHOLD) {
      // This sensor detects the white line.
      sum += Position[i];
      count++;
    }
  }

  if (count == 0) {
    return 999;  // No sensor detects white
  }

  return sum / count;
}

bool middleSensorsSeeWhite() {
  // Middle sensors are A3 and A2: indexes 2 and 3.
  return Sensor_Value[2] < SENSOR_THRESHOLD ||
         Sensor_Value[3] < SENSOR_THRESHOLD;
}

void printPattern() {
  for (int i = 0; i < Num_Sensor; i++) {
    Serial.print(Sensor_Value[i] < SENSOR_THRESHOLD ? '0' : '1');
  }
}

// direction: -1 = left pivot; +1 = right pivot.
// Stops when the middle sensors reacquire the white line or when time runs out.
bool pivotUntilLineReacquired(int direction) {
  if (direction < 0) {
    setMotorsSigned(-TURN_SPEED, TURN_SPEED);
    Serial.println("PIVOT LEFT");
  } else {
    setMotorsSigned(TURN_SPEED, -TURN_SPEED);
    Serial.println("PIVOT RIGHT");
  }

  const unsigned long startTime = millis();
  int consecutiveReadings = 0;

  while (millis() - startTime < TURN_TIMEOUT_MS) {
    readSensors();

    if (millis() - startTime >= TURN_MIN_TIME_MS) {
      if (middleSensorsSeeWhite()) {
        consecutiveReadings++;
      } else {
        consecutiveReadings = 0;
      }

      if (consecutiveReadings >= REACQUIRE_READINGS) {
        setMotors(0, 0);
        delay(TURN_SETTLE_MS);
        readSensors();
        Serial.println("LINE REACQUIRED");
        return true;
      }
    }

    delay(10);
  }

  setMotors(0, 0);
  Serial.println("TURN TIMEOUT - STOPPED");
  return false;
}

void loop() {
  readSensors();

  // Pattern bits are printed left-to-right, matching Sensor_Pins.
  bool leftPivotPattern =
    Sensor_Value[0] < SENSOR_THRESHOLD &&
    Sensor_Value[1] >= SENSOR_THRESHOLD &&
    Sensor_Value[2] >= SENSOR_THRESHOLD &&
    Sensor_Value[3] >= SENSOR_THRESHOLD &&
    Sensor_Value[4] >= SENSOR_THRESHOLD &&
    Sensor_Value[5] >= SENSOR_THRESHOLD;  // 100000

  bool rightPivotPattern =
    Sensor_Value[0] >= SENSOR_THRESHOLD &&
    Sensor_Value[1] >= SENSOR_THRESHOLD &&
    Sensor_Value[2] >= SENSOR_THRESHOLD &&
    Sensor_Value[3] >= SENSOR_THRESHOLD &&
    Sensor_Value[4] >= SENSOR_THRESHOLD &&
    Sensor_Value[5] < SENSOR_THRESHOLD;   // 000001

  bool isPivotPattern = leftPivotPattern || rightPivotPattern;

  if (!isPivotPattern) {
    // Re-arm after leaving the exact pivot-trigger pattern.
    turnPatternLocked = false;
  }

  if (isPivotPattern && !turnPatternLocked) {
    turnPatternLocked = true;

    if (leftPivotPattern) {
      pivotUntilLineReacquired(-1);
    } else {
      pivotUntilLineReacquired(+1);
    }
  } else if (turnPatternLocked) {
    // Prevent repeated pivots while the same edge pattern remains.
    setMotors(0, 0);
  } else {
    float error = calculateError();

    if (error == 999) {
      setMotors(0, 0);
      Serial.println("LINE LOST - STOP");

    } else if (error <= -1.0) {
      setMotors(180, 100);
      Serial.println("LINE LEFT");

    } else if (error < -0.25) {
      setMotors(170, 130);
      Serial.println("SLIGHT LEFT");

    } else if (error >= 1.0) {
      setMotors(100, 180);
      Serial.println("LINE RIGHT");

    } else if (error > 0.25) {
      setMotors(130, 170);
      Serial.println("SLIGHT RIGHT");

    } else {
      setMotors(150, 150);
      Serial.println("LINE CENTRE");
    }
  }

  Serial.print("Pattern: ");
  printPattern();
  Serial.print(" | Error: ");
  Serial.println(calculateError());

  delay(30);
}
